# ==========================================
# Wavo - Social Movie Watch Platform
# Environment Configuration
# ==========================================

# Supabase Auth & Realtime
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# TMDB (The Movie Database) API
# Get your free v3 API key at https://www.themoviedb.org/settings/api
# If left blank, Wavo automatically uses the comprehensive built-in curated catalog
NEXT_PUBLIC_TMDB_API_KEY=

# Public App Base URL (used for generating room invite links)
# Defaults to window.location.origin in the browser if unset
NEXT_PUBLIC_APP_URL=http://localhost:3000
